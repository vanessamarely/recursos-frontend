---
interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

interface NavItem {
  title: string;
  slug: string;
  icon: string;
  children?: NavItem[];
}

const navigation: NavItem[] = [
  {
    title: 'Internet',
    slug: 'internet',
    icon: 'internet',
    children: [
      { title: 'HTTP (Protocolos)', slug: 'http', icon: 'internet' },
      { title: 'Navegadores', slug: 'browsers', icon: 'internet' },
      { title: 'Web', slug: 'web', icon: 'internet' },
    ],
  },
  { title: 'HTML', slug: 'html', icon: 'html' },
  { title: 'CSS', slug: 'css', icon: 'css' },
  { title: 'JavaScript', slug: 'javascript', icon: 'javascript' },
  { title: 'TypeScript', slug: 'typescript', icon: 'typescript' },
  {
    title: 'Librerías & Frameworks',
    slug: 'librerias-frameworks',
    icon: 'librerias-frameworks',
    children: [
      { title: 'General', slug: 'librerias-frameworks', icon: 'librerias-frameworks' },
        { title: 'Angular', slug: 'angular', icon: 'angular' },
        { title: 'React', slug: 'react', icon: 'react' },
        { title: 'Vue', slug: 'vue', icon: 'vue' },
    ],
  },
  { title: 'Git', slug: 'git', icon: 'git' },
  { title: 'Otros', slug: 'otros', icon: 'otros' },
  {
    title: 'Libros',
    slug: 'libros',
    icon: 'libros',
    children: [
      { title: 'General', slug: 'libros', icon: 'libros' },
        { title: 'JavaScript', slug: 'libros-javascript', icon: 'libros-javascript' },
    ],
  },
];

function isActive(slug: string, currentSlug?: string): boolean {
  return slug === currentSlug;
}

function hasActiveChild(item: NavItem, currentSlug?: string): boolean {
  if (!item.children) return false;
  return item.children.some(child => child.slug === currentSlug);
}

function withBase(path: string): string {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  const normalizedPath = path.startsWith('/') ? path : `/${path}`;
  return `${normalizedBase}${normalizedPath}`;
}
---

<div class="flex flex-col h-full">
  <div class="p-6 border-b border-border">
    <a href={baseUrl} class="flex items-center gap-3 mb-2 no-underline">
      <img src={withBase('icons/logo.svg')} alt="Recursos logo" class="w-8 h-8" />
      <div>
        <h1 class="text-xl font-bold text-foreground">Recursos Frontend</h1>
        <p class="text-xs text-muted-foreground">Tu guía de aprendizaje</p>
      </div>
    </a>
  </div>

  <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
    {navigation.map((item) => {
      if (item.children && item.children.length > 0) {
        const groupActive = hasActiveChild(item, activeSlug);
        return (
          <details open={groupActive || isActive(item.slug, activeSlug)} class="group">
            <summary class="flex items-center gap-3 px-3 py-3 rounded-md cursor-pointer hover:bg-muted font-medium text-sm list-none">
              <img src={withBase(`icons/${item.icon}.svg`)} alt={`${item.title} icon`} class="w-6 h-6 flex-shrink-0" />
              <span class="flex-1">{item.title}</span>
              <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="pl-6 mt-1 space-y-1">
              {item.children.map((child) => (
                <a
                  href={withBase(child.slug)}
                  class:list={[
                    'flex items-center gap-2 px-3 py-2 rounded-md text-sm no-underline transition-colors',
                    isActive(child.slug, activeSlug)
                      ? 'bg-muted border-l-4 border-primary font-medium text-foreground'
                      : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                  ]}
                >
                  <img src={withBase(`icons/${child.icon}.svg`)} alt={`${child.title} icon`} class="w-5 h-5 flex-shrink-0" />
                  <span>{child.title}</span>
                </a>
              ))}
            </div>
          </details>
        );
      }

      return (
        <a
          href={withBase(item.slug)}
          class:list={[
            'flex items-center gap-3 px-3 py-3 rounded-md text-sm no-underline transition-colors',
            isActive(item.slug, activeSlug)
              ? 'bg-muted border-l-4 border-primary font-medium text-foreground'
              : 'text-muted-foreground hover:bg-muted hover:text-foreground',
          ]}
        >
          <img src={withBase(`icons/${item.icon}.svg`)} alt={`${item.title} icon`} class="w-6 h-6 flex-shrink-0" />
          <span>{item.title}</span>
        </a>
      );
    })}
  </nav>

  <div class="p-4 border-t border-border">
    <p class="text-xs text-muted-foreground text-center">
      Hecho con 💙 para la comunidad Frontend
    </p>
  </div>
</div>
